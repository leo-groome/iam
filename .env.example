# Variables para `docker compose up` (cp .env.example .env). Todas son opcionales en dev.
# Para correr cada app fuera de Docker usa apps/*/.env.example.

# ── Auth ──
# BETTER_AUTH_SECRET=            # dev: hay un default inseguro en compose.yaml
# RESEND_API_KEY=                # vacío => los OTP salen en `docker compose logs auth`
# EMAIL_FROM=Campus IAM <no-reply@tudominio.com>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Storage ──
# Por defecto usa el S3 mock local (:9000) + gateway (:8787).
# Para usar Cloudflare R2 real descomenta TODO este bloque (y apaga el mock con
# `docker compose up --scale s3=0 --scale media-gateway=0`):
# R2_ENDPOINT_URL=               # vacío = R2 real
# R2_INTERNAL_ENDPOINT_URL=      # DEJAR VACÍO con R2 real (si no se define, compose usa el del mock http://s3:9090)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=iam-media
# R2_PUBLIC_BASE=https://media.tudominio.com
# MEDIA_JWT_SECRET=

# ── QA ──
# ALLOW_MOCK_AUTH=false          # true solo para el perfil `seed` / E2E
