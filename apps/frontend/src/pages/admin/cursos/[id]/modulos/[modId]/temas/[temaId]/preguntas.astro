---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { apiGet, ApiError } from "@/lib/api";
import type { components } from "@/lib/types.gen";

type TopicResponse = components["schemas"]["TopicResponse"];
type QuestionResponse = components["schemas"]["QuestionResponse"];
type OptionResponse = components["schemas"]["OptionResponse"];

const { id, modId, temaId } = Astro.params;

let tema: TopicResponse | null = null;
let questions: QuestionResponse[] = [];
let fetchError: string | null = null;

try {
  tema = (await apiGet("/api/v1/admin/topics/{topic_id}", {
    params: { topic_id: temaId! },
    request: Astro.request,
  })) as TopicResponse;
  // NOTE: No GET endpoint exists for listing questions by topic in the current API.
  // Questions management is done via POST /api/v1/admin/topics/{topic_id}/questions
  // and PATCH/DELETE /api/v1/admin/questions/{question_id}.
  // The list will be available once the backend exposes a GET endpoint.
  questions = [];
} catch (e) {
  if (e instanceof ApiError && e.status === 404) {
    return Astro.redirect(`/admin/cursos/${id}/modulos/${modId}`);
  }
  fetchError = e instanceof ApiError ? e.message : "Error al cargar preguntas";
}
---

<AdminLayout title="Banco de preguntas" section="cursos">
  <a
    href={`/admin/cursos/${id}/modulos/${modId}/temas/${temaId}`}
    class="text-sm text-[var(--color-text-muted)] mb-3 inline-block"
  >
    ← Tema
  </a>

  {fetchError && (
    <div class="card p-6 text-center text-[var(--color-error)] mb-6" role="alert">
      {fetchError}
    </div>
  )}

  <header class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold">Banco de preguntas</h1>
      <p class="text-[var(--color-text-muted)]">
        {questions.length} pregunta{questions.length !== 1 ? "s" : ""} activa{questions.length !== 1 ? "s" : ""}
      </p>
    </div>
    <a
      href={`/admin/cursos/${id}/modulos/${modId}/temas/${temaId}/preguntas/nueva`}
      class="btn btn-primary"
    >
      + Agregar pregunta
    </a>
  </header>

  {tema && (
    <div class="card p-6 mb-6">
      <label class="label">% mínimo para aprobar</label>
      <div class="flex items-center gap-3">
        <input
          type="number"
          class="input max-w-32"
          min="50"
          max="100"
          value={tema.exam_min_score}
        />
        <p class="text-sm text-[var(--color-text-muted)]">Mínimo 50, máximo 100.</p>
      </div>
    </div>
  )}

  {questions.length === 0 && !fetchError && (
    <div class="card p-10 text-center text-[var(--color-text-muted)]">
      Sin preguntas todavía. Agrega la primera.
    </div>
  )}

  <div class="space-y-3">
    {questions.map((p: QuestionResponse, i: number) => (
      <div class="card p-5">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1">
            <p class="text-xs text-[var(--color-text-muted)] mb-1">Pregunta {i + 1}</p>
            <p class="font-semibold">{p.enunciado}</p>
            <ul class="mt-3 space-y-1 text-sm">
              {p.options.map((opt: OptionResponse) => (
                <li
                  class={`flex items-center gap-2 ${opt.is_correct ? "text-emerald-700 font-medium" : "text-[var(--color-text-muted)]"}`}
                >
                  <span>{opt.is_correct ? "✓" : "○"}</span>
                  <span>{opt.texto}</span>
                </li>
              ))}
            </ul>
          </div>
          <a
            href={`/admin/cursos/${id}/modulos/${modId}/temas/${temaId}/preguntas/${p.id}`}
            class="btn btn-secondary"
          >
            Editar
          </a>
        </div>
      </div>
    ))}
  </div>
</AdminLayout>
