---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import type { components } from "@/lib/types.gen";

type OptionResponse = components["schemas"]["OptionResponse"];

const { id, modId, temaId, qId } = Astro.params;
const isNew = qId === "nueva";
const backUrl = `/admin/cursos/${id}/modulos/${modId}/temas/${temaId}/preguntas`;

// NOTE: The API has no GET /api/v1/admin/questions/{question_id} endpoint.
// The form always renders as a new-question shell; saves via PATCH happen client-side.
// When the backend exposes a read endpoint, add an apiGet call here.
const opts: OptionResponse[] = [
  { id: "", question_id: "", texto: "", is_correct: false, order_index: 0 },
  { id: "", question_id: "", texto: "", is_correct: false, order_index: 1 },
  { id: "", question_id: "", texto: "", is_correct: false, order_index: 2 },
];
---

<AdminLayout title={isNew ? "Nueva pregunta" : "Editar pregunta"} section="cursos">
  <a href={backUrl} class="text-sm text-[var(--color-text-muted)] mb-3 inline-block">
    ← Banco de preguntas
  </a>

  <header class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">
      {isNew ? "Nueva pregunta" : "Editar pregunta"}
    </h1>
    <div class="flex gap-2">
      <a href={backUrl} class="btn btn-secondary">Cancelar</a>
      <button class="btn btn-primary" type="button">Guardar</button>
    </div>
  </header>

  <div class="card p-6 space-y-5 max-w-2xl">
    <div>
      <label class="label">Enunciado</label>
      <textarea class="input min-h-24" maxlength="300" placeholder="Escribe la pregunta"></textarea>
      <p class="help">5–300 caracteres.</p>
    </div>
    <div>
      <label class="label">Opciones de respuesta</label>
      <p class="help mb-3">Marca cuál es la correcta (3 a 5 opciones).</p>
      <div class="space-y-2">
        {opts.map((opt: OptionResponse, i: number) => (
          <div class="flex items-center gap-3">
            <input
              type="radio"
              name="correcta"
              checked={opt.is_correct}
              class="w-5 h-5 accent-[var(--color-primary)]"
              aria-label={`Marcar opción ${i + 1} como correcta`}
            />
            <input
              class="input flex-1"
              maxlength="150"
              value={opt.texto}
              placeholder={`Opción ${i + 1}`}
            />
            <button
              class="text-[var(--color-text-muted)] hover:text-[var(--color-error)]"
              aria-label="Eliminar opción"
              type="button"
            >
              ✕
            </button>
          </div>
        ))}
      </div>
      <button class="btn btn-ghost mt-3 text-sm" type="button">+ Agregar opción</button>
    </div>
  </div>
</AdminLayout>
