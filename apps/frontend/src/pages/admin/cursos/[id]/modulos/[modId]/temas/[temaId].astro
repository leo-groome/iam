---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { apiGet, ApiError } from "@/lib/api";
import type { components } from "@/lib/types.gen";

type TopicResponse = components["schemas"]["TopicResponse"];

const { id, modId, temaId } = Astro.params;
const isNew = temaId === "nuevo";

let tema: TopicResponse | null = null;
let fetchError: string | null = null;

if (!isNew) {
  try {
    tema = (await apiGet("/api/v1/admin/topics/{topic_id}", {
      params: { topic_id: temaId! },
      request: Astro.request,
    })) as TopicResponse;
  } catch (e) {
    if (e instanceof ApiError && e.status === 404) {
      return Astro.redirect(`/admin/cursos/${id}/modulos/${modId}`);
    }
    fetchError = e instanceof ApiError ? e.message : "Error al cargar el tema";
  }
}
---

<AdminLayout title={isNew ? "Nuevo tema" : tema?.title ?? "Tema"} section="cursos">
  <a
    href={`/admin/cursos/${id}/modulos/${modId}`}
    class="text-sm text-[var(--color-text-muted)] mb-3 inline-block"
  >
    ← Módulo
  </a>

  {fetchError && (
    <div class="card p-6 text-center text-[var(--color-error)] mb-6" role="alert">
      {fetchError}
    </div>
  )}

  <header class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">
      {isNew ? "Nuevo tema" : `Editar: ${tema?.title}`}
    </h1>
    <button class="btn btn-primary" type="button">Guardar</button>
  </header>

  <div class="grid lg:grid-cols-3 gap-6">
    <div class="card p-6 lg:col-span-2 space-y-4">
      <div>
        <label class="label">Título</label>
        <input class="input" minlength="3" maxlength="60" value={tema?.title ?? ""} />
      </div>
      <div>
        <label class="label">Tipo de contenido</label>
        <select class="input">
          <option value="video" selected={tema?.content_type === "video"}>Video</option>
          <option value="pdf" selected={tema?.content_type === "pdf"}>PDF</option>
          <option value="imagen" selected={tema?.content_type === "imagen"}>
            Imagen / Infografía
          </option>
          <option value="texto" selected={tema?.content_type === "texto"}>
            Texto enriquecido
          </option>
        </select>
      </div>
      <div>
        <label class="label">Subir archivo</label>
        <div class="border-2 border-dashed border-[var(--color-border)] rounded-xl p-8 text-center text-sm text-[var(--color-text-muted)]">
          Arrastra video (mp4/webm, máx 500 MB) o PDF (máx 50 MB).
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="card p-6">
        <h3 class="font-semibold mb-3">Examen</h3>
        <label class="flex items-center justify-between text-sm">
          <span>Requiere cuestionario</span>
          <input type="checkbox" checked={tema?.has_exam ?? false} />
        </label>
        {tema?.has_exam && (
          <a
            href={`/admin/cursos/${id}/modulos/${modId}/temas/${temaId}/preguntas`}
            class="btn btn-secondary btn-block mt-4"
          >
            Editar banco de preguntas
          </a>
        )}
        {tema && (
          <p class="text-xs text-[var(--color-text-muted)] mt-3">
            Mínimo para aprobar: {tema.exam_min_score}%
          </p>
        )}
      </div>
    </div>
  </div>
</AdminLayout>
