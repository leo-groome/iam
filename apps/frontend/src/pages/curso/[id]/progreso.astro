---
export const prerender = false

import StudentLayout from "@/layouts/StudentLayout.astro";
import ProgressBar from "@/components/ui/ProgressBar.vue";
import { apiGet, ApiError } from "@/lib/api";
import type { CourseDetail, CourseProgress } from "@/lib/api";

const slug = Astro.params.id!

let course: CourseDetail
let progress: CourseProgress

try {
  course = await apiGet('/api/v1/courses/{slug}', {
    params: { slug },
    request: Astro.request,
  }) as CourseDetail
} catch (err) {
  if (err instanceof ApiError && err.status === 401) {
    return Astro.redirect(`/registro?next=${encodeURIComponent(Astro.url.pathname)}`)
  }
  if (err instanceof ApiError && err.status === 404) {
    return Astro.redirect('/catalogo')
  }
  throw err
}

try {
  progress = await apiGet('/api/v1/courses/{slug}/progress', {
    params: { slug },
    request: Astro.request,
  }) as CourseProgress
} catch {
  progress = { course_pct: 0, modules: [] }
}

// Build topic state map indexed by topic id
const topicStateMap: Record<string, string> = {}
for (const mp of progress.modules) {
  for (const ts of mp.topics) {
    topicStateMap[ts.id] = ts.state
  }
}

// Count completed topics
const allTopicIds = course.modules.flatMap(m => m.topics.map(t => t.id))
const completedCount = allTopicIds.filter(id => topicStateMap[id] === 'completed').length
const totalCount = allTopicIds.length

// Per-module completion counts
function moduleCompletedCount(moduleId: string): number {
  const mp = progress.modules.find(m => m.id === moduleId)
  if (!mp) return 0
  return mp.topics.filter(ts => ts.state === 'completed').length
}
---
<StudentLayout title="Mi progreso" courseName={course.title} progress={progress.course_pct}>
  <a href={`/curso/${slug}`} class="text-sm text-[var(--color-text-muted)] mb-3 inline-block">← Volver al curso</a>

  <h1 class="text-3xl font-bold mb-2">Mi progreso</h1>
  <p class="text-[var(--color-text-muted)] mb-6">{course.title}</p>

  <div class="card p-6 mb-6">
    <ProgressBar client:load value={progress.course_pct} showPercent label="Progreso total" />
    <p class="text-sm text-[var(--color-text-muted)] mt-4">{completedCount} de {totalCount} temas completados</p>
  </div>

  <div class="space-y-4">
    {course.modules.map((mod, mi) => {
      const modTopics = mod.topics
      const modCompleted = moduleCompletedCount(mod.id)
      const modProgress = modTopics.length > 0 ? Math.round((modCompleted / modTopics.length) * 100) : 0
      return (
        <div class="card p-5">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div>
              <p class="text-xs text-[var(--color-text-muted)]">Módulo {mi + 1}</p>
              <h3 class="font-semibold">{mod.title}</h3>
            </div>
            <span class="chip">{modProgress}%</span>
          </div>
          <ul class="space-y-1.5">
            {modTopics.map(t => {
              const state = topicStateMap[t.id] ?? 'pending'
              const isCompleted = state === 'completed'
              return (
                <li class="flex items-center gap-2 text-sm">
                  <span class={`w-5 h-5 rounded-full grid place-items-center text-[10px] font-bold ${isCompleted ? 'bg-emerald-100 text-emerald-700' : 'bg-[var(--color-primary-soft)] text-[var(--color-primary)]'}`}>
                    {isCompleted ? '✓' : ''}
                  </span>
                  <span class={!isCompleted ? 'text-[var(--color-text-muted)]' : ''}>{t.title}</span>
                  {t.has_exam && <span class="ml-auto text-[10px] chip">Examen</span>}
                </li>
              )
            })}
          </ul>
        </div>
      )
    })}
  </div>
</StudentLayout>
