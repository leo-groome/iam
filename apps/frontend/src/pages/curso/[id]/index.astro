---
export const prerender = false

import StudentLayout from "@/layouts/StudentLayout.astro";
import ProgressBar from "@/components/ui/ProgressBar.vue";
import { apiGet, ApiError } from "@/lib/api";
import type { CourseDetail, CourseProgress } from "@/lib/api";

const slug = Astro.params.id!;

let course: CourseDetail
let progress: CourseProgress

try {
  course = await apiGet('/api/v1/courses/{slug}', {
    params: { slug },
    request: Astro.request,
  }) as CourseDetail
} catch (err) {
  if (err instanceof ApiError && err.status === 404) {
    return Astro.redirect('/catalogo')
  }
  if (err instanceof ApiError && err.status === 401) {
    return Astro.redirect(`/registro?next=${encodeURIComponent(Astro.url.pathname)}`)
  }
  throw err
}

try {
  progress = await apiGet('/api/v1/courses/{slug}/progress', {
    params: { slug },
    request: Astro.request,
  }) as CourseProgress
} catch {
  // Progress fetch is non-critical — default to 0
  progress = { course_pct: 0, modules: [] }
}

const isEnrolled = course.enrollment_status !== 'not_enrolled'

// Find first non-completed topic for CTA
const allTopics = course.modules.flatMap(m => m.topics)
const firstPendingTopic = allTopics.find(t => {
  const modProgress = progress.modules.find(mp => mp.id === course.modules.find(m => m.topics.some(tt => tt.id === t.id))?.id)
  const topicState = modProgress?.topics.find(ts => ts.id === t.id)
  return topicState?.state !== 'completed'
}) ?? allTopics[0]

const ctaHref = firstPendingTopic
  ? `/curso/${slug}/tema/${firstPendingTopic.id}`
  : `/curso/${slug}/progreso`

const ctaLabel = progress.course_pct > 0 ? "Continuar" : "Empezar curso"

// Build a topic state map for rendering
const topicStateMap: Record<string, string> = {}
for (const mp of progress.modules) {
  for (const ts of mp.topics) {
    topicStateMap[ts.id] = ts.state
  }
}
---
<StudentLayout title={course.title}>
  <a href="/catalogo" class="text-sm text-[var(--color-text-muted)] mb-4 inline-block">← Catálogo</a>

  <div class="card overflow-hidden mb-6">
    {course.cover_key && (
      <div class="aspect-[21/9] bg-[var(--color-primary-soft)] overflow-hidden">
        <img src={course.cover_key} alt={course.title} class="w-full h-full object-cover" loading="lazy" />
      </div>
    )}
    <div class="p-6 sm:p-8">
      <h1 class="text-3xl font-bold tracking-tight">{course.title}</h1>
      <p class="text-[var(--color-text-muted)] mt-3 leading-relaxed">{course.long_desc}</p>

      <div class="flex flex-wrap gap-2 mt-5">
        <span class="chip">{course.modules.length} módulos</span>
        <span class="chip">Certificado al terminar</span>
        {course.age_min && <span class="chip">+{course.age_min} años</span>}
      </div>

      {isEnrolled && (
        <div class="mt-6">
          <ProgressBar client:visible value={progress.course_pct} label="Tu progreso" showPercent />
        </div>
      )}
    </div>
  </div>

  <!-- Enroll CTA for non-enrolled users -->
  {!isEnrolled && (
    <div class="card p-6 mb-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="flex-1">
        <h2 class="font-semibold text-lg">Inscríbete para comenzar</h2>
        <p class="text-sm text-[var(--color-text-muted)] mt-1">Accede a todo el contenido y obtén tu certificado al terminar.</p>
      </div>
      <enroll-island data-slug={slug} class="shrink-0" />
    </div>
  )}

  <h2 class="text-lg font-semibold mb-3">Contenido del curso</h2>
  <div class="space-y-3 mb-8">
    {course.modules.map((mod, idx) => (
      <details class="card p-5" open={idx === 0}>
        <summary class="flex items-start justify-between gap-3 cursor-pointer list-none">
          <div class="flex-1 min-w-0">
            <p class="text-xs text-[var(--color-text-muted)] mb-1">Módulo {idx + 1}</p>
            <h3 class="font-semibold">{mod.title}</h3>
          </div>
        </summary>
        <ul class="mt-4 space-y-2 border-t border-[var(--color-border)] pt-4">
          {mod.topics.map((topic, ti) => {
            const state = topicStateMap[topic.id] ?? 'pending'
            const isCompleted = state === 'completed'
            const isLocked = !isEnrolled
            return (
              <li class="flex items-center gap-3 text-sm">
                <span class={`w-7 h-7 rounded-full grid place-items-center text-xs font-semibold ${isCompleted ? 'bg-emerald-100 text-emerald-700' : isLocked ? 'bg-[var(--color-app-bg)] text-[var(--color-text-muted)]' : 'bg-[var(--color-primary-soft)] text-[var(--color-primary)]'}`}>
                  {isCompleted ? '✓' : ti + 1}
                </span>
                {isEnrolled
                  ? <a href={`/curso/${slug}/tema/${topic.id}`} class={`hover:text-[var(--color-primary)] transition-colors ${isCompleted ? 'text-[var(--color-text-muted)] line-through' : ''}`}>{topic.title}</a>
                  : <span class="text-[var(--color-text-muted)]">{topic.title}</span>
                }
                {topic.has_exam && <span class="ml-auto text-xs chip">Examen</span>}
              </li>
            )
          })}
        </ul>
      </details>
    ))}
  </div>

  {isEnrolled && (
    <div class="fixed bottom-0 left-0 right-0 bg-[var(--color-surface)] border-t border-[var(--color-border)] p-4 sm:static sm:bg-transparent sm:border-0 sm:p-0">
      <div class="max-w-3xl mx-auto">
        <a href={ctaHref} class="btn btn-primary btn-block">{ctaLabel}</a>
      </div>
    </div>
  )}
</StudentLayout>

<script>
  // Minimal enroll island — posts to API then reloads
  class EnrollIsland extends HTMLElement {
    connectedCallback() {
      const slug = this.dataset.slug
      if (!slug) return

      const btn = document.createElement('button')
      btn.className = 'btn btn-primary'
      btn.textContent = 'Inscribirme gratis'

      btn.addEventListener('click', async () => {
        btn.disabled = true
        btn.textContent = 'Inscribiendo...'
        try {
          const cookieName = 'neon-auth-token'
          const token = document.cookie.split(';').map(c => c.trim()).find(c => c.startsWith(cookieName + '='))?.split('=').slice(1).join('=')
          const res = await fetch(`/api/v1/courses/${slug}/enroll`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              ...(token ? { Authorization: `Bearer ${decodeURIComponent(token)}` } : {}),
            },
          })
          if (res.ok) {
            window.location.reload()
          } else {
            btn.disabled = false
            btn.textContent = 'Inscribirme gratis'
            alert('No se pudo completar la inscripción. Intenta de nuevo.')
          }
        } catch {
          btn.disabled = false
          btn.textContent = 'Inscribirme gratis'
        }
      })

      this.appendChild(btn)
    }
  }
  customElements.define('enroll-island', EnrollIsland)
</script>
