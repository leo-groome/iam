---
export const prerender = false

import StudentLayout from "@/layouts/StudentLayout.astro";
import ExamRunner from "@/components/ui/ExamRunner.vue";
import { apiGet, ApiError } from "@/lib/api";
import type { TopicDetail } from "@/lib/api";

const { id, temaId } = Astro.params;

if (!id || !temaId) return Astro.redirect('/catalogo');

// SSR guard: verify topic exists and user is enrolled (403 = not enrolled)
let topicTitle = 'Examen'
try {
  const topic = (await apiGet('/api/v1/topics/{topic_id}', {
    params: { topic_id: temaId },
    request: Astro.request,
  })) as TopicDetail
  topicTitle = topic.title
} catch (err) {
  if (err instanceof ApiError) {
    if (err.status === 401) return Astro.redirect(`/registro?next=${encodeURIComponent(Astro.url.pathname)}`)
    if (err.status === 403) return Astro.redirect(`/curso/${id}`)
    if (err.status === 404) return Astro.redirect(`/curso/${id}`)
  }
  // Other errors: let page render — ExamRunner will surface its own error state
}
---
<StudentLayout title={`Examen · ${topicTitle}`}>
  <p class="text-sm text-[var(--color-primary)] font-medium">Cuestionario</p>
  <h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-6">{topicTitle}</h1>

  <ExamRunner client:load topicId={temaId} cursoId={id} />

  <div class="h-32"></div>
</StudentLayout>
