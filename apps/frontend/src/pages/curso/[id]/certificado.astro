---
export const prerender = false;

import StudentLayout from "@/layouts/StudentLayout.astro";
import { apiGet, apiPost, ApiError } from "@/lib/api";
import type { components } from "@/lib/types.gen";

type CourseDetail = components["schemas"]["CourseDetail"];
type CertificatePublic = components["schemas"]["CertificatePublic"];

const { id: slug } = Astro.params;

let cert: CertificatePublic | null = null;
let courseTitle: string = "";
let notAvailable: string | null = null;

try {
  // 1. Resolve slug → numeric course id
  const course = (await apiGet("/api/v1/courses/{slug}", {
    params: { slug: slug! },
    request: Astro.request,
  })) as CourseDetail;
  courseTitle = course.title;

  // 2. Issue (or retrieve existing) certificate
  cert = (await apiPost("/api/v1/certificates/issue/{course_id}", {
    params: { course_id: course.id },
    request: Astro.request,
  })) as CertificatePublic;
} catch (e) {
  if (e instanceof ApiError) {
    if (e.status === 401 || e.status === 403) {
      notAvailable = "Aún no puedes obtener este certificado. Completa el curso primero.";
    } else if (e.status === 404) {
      return Astro.redirect("/catalogo");
    } else {
      notAvailable = e.message ?? "No disponible aún";
    }
  } else {
    notAvailable = "Error de conexión. Intenta de nuevo.";
  }
}

const issuedDate = cert
  ? new Date(cert.issued_at).toLocaleDateString("es-MX", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : "";
---

<StudentLayout title="¡Felicidades!" courseName={courseTitle || "Curso"} progress={100}>
  {notAvailable ? (
    <div class="text-center py-16">
      <div class="text-5xl mb-4">🔒</div>
      <h1 class="text-2xl font-bold mb-3">Certificado no disponible</h1>
      <p class="text-[var(--color-text-muted)] mb-6">{notAvailable}</p>
      <a href="/catalogo" class="btn btn-secondary">Ver cursos</a>
    </div>
  ) : cert && (
    <>
      <div class="text-center mb-8">
        <div class="text-6xl mb-3">🎓</div>
        <h1 class="text-4xl font-bold tracking-tight">¡Felicidades!</h1>
        <p class="text-[var(--color-text-muted)] mt-2 text-lg">Completaste el curso. Aquí tienes tu certificado.</p>
      </div>

      <div class="card p-6 sm:p-10 mb-6 border-4 border-[var(--color-primary-soft)] relative overflow-hidden">
        <img
          src="/MISIONERAS_LOGO.svg"
          alt=""
          aria-hidden="true"
          class="pointer-events-none select-none absolute inset-0 m-auto w-[85%] h-[85%] object-contain opacity-20"
        />

        <div class="relative border-2 border-[var(--color-primary)] rounded-2xl p-6 sm:p-10 text-center">
          <p class="text-sm text-[var(--color-primary)] tracking-widest font-semibold uppercase">
            Certificado de finalización
          </p>
          <div class="my-6 sm:my-8">
            <p class="text-[var(--color-text-muted)]">Se otorga a</p>
            <p class="text-3xl sm:text-4xl font-bold mt-2">{cert.student_name}</p>
          </div>
          <p class="text-[var(--color-text-muted)]">por haber completado satisfactoriamente</p>
          <p class="text-xl sm:text-2xl font-bold mt-2">{cert.course_title}</p>
          <div class="mt-8 flex justify-between items-end text-xs text-[var(--color-text-muted)] gap-4">
            <div class="text-left">
              <p class="font-semibold text-[var(--color-text)]">{issuedDate}</p>
              <p>Fecha de emisión</p>
            </div>
            <img src="/MISIONERAS_LOGO.svg" alt="Misioneras" class="h-14 w-auto" />
            <div class="text-right">
              <p class="font-semibold text-[var(--color-text)]">
                #{cert.public_uuid.slice(0, 8).toUpperCase()}
              </p>
              <p>ID del certificado</p>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-3">
        <a
          href={cert.verify_url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary btn-block"
        >
          Verificar certificado
        </a>
        <button
          class="btn btn-primary btn-block"
          onclick="window.print()"
          type="button"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <path d="M7 10l5 5 5-5"/>
            <path d="M12 15V3"/>
          </svg>
          Descargar / Imprimir
        </button>
        <a href="/catalogo" class="btn btn-secondary btn-block">Ver otros cursos</a>
      </div>
    </>
  )}
</StudentLayout>
