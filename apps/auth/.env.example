# ── Servicio de autenticación (Better Auth) ────────────────────────────────
NODE_ENV=development
PORT=3001

# URL pública del servicio, sin path ni slash final. Es el iss/aud de los JWT:
# el backend debe usar exactamente este valor en AUTH_BASE_URL.
BETTER_AUTH_URL=http://localhost:3001
# Mínimo 32 chars. Generar: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret-xxxxxxxx

# Postgres (misma base que el backend; Better Auth usa su propio schema)
DATABASE_URL=postgresql://iam:iam@localhost:5433/iam
# disable = red privada/local | require = TLS verificando certificado | no-verify = evitar
DB_SSL=disable
# DB_CA_CERT=            # PEM del CA si el servidor no usa un CA público
DB_SCHEMA=auth

# Orígenes (CSV) del frontend/landing autorizados (CORS + CSRF)
TRUSTED_ORIGINS=http://localhost:4321
# COOKIE_DOMAIN=.tudominio.com   # solo producción, para compartir cookie entre subdominios

# Correo (Resend). Obligatorio en producción; en dev vacío => el OTP se imprime en logs.
RESEND_API_KEY=
EMAIL_FROM=Campus IAM <no-reply@example.com>

# Google OAuth (opcional). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
