# ── API (FastAPI) ──────────────────────────────────────────────────────────
# Postgres. Local: localhost:5433 (docker compose up -d db). Railway: URL privada + DB_SSL=disable.
DATABASE_URL=postgresql+asyncpg://iam:iam@localhost:5433/iam
DB_SSL=disable            # require | disable

# Servicio de auth. AUTH_BASE_URL == BETTER_AUTH_URL (iss/aud que se exige al JWT).
AUTH_BASE_URL=http://localhost:3001
# Opcional; por defecto ${AUTH_BASE_URL}/api/auth/jwks. En Railway: URL privada del servicio auth.
# AUTH_JWKS_URL=http://auth.railway.internal:3001/api/auth/jwks

FRONTEND_URL=http://localhost:4321
CERTIFICATE_VERIFY_BASE_URL=http://localhost:8000

# ── Cloudflare R2 (media y certificados) ───────────────────────────────────
# Cloudflare → R2 → Manage API tokens (permiso Object Read & Write sobre el bucket)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=iam-media
# Vacío = R2 real (https://<account>.r2.cloudflarestorage.com). Solo se llena para S3 local.
R2_ENDPOINT_URL=
# Solo Docker local: endpoint S3 visto desde el contenedor (http://s3:9090). Vacío en producción.
R2_INTERNAL_ENDPOINT_URL=
# URL pública del Worker (infra/worker) que sirve la media. Local: http://localhost:8787
R2_PUBLIC_BASE=https://media.iam.example
# Mismo valor que `wrangler secret put MEDIA_JWT_SECRET` del Worker. Mín. 32 chars.
MEDIA_JWT_SECRET=replace-with-32-byte-random-secret

# ── Correo ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Solo QA/tests (NUNCA en producción) ────────────────────────────────────
# ALLOW_MOCK_AUTH=false
# ENFORCE_REALTIME_HEARTBEAT=true
# VERIFY_PDF_PAGES_SERVER_SIDE=true
