DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/dbname
NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth
# NEON_AUTH_JWKS_URL defaults to ${NEON_AUTH_URL}/.well-known/jwks.json
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=iam-media
R2_PUBLIC_BASE=https://media.iam.example
MEDIA_JWT_SECRET=replace-with-32-byte-random-secret
FRONTEND_URL=https://app.iam.example
RESEND_API_KEY=re_xxxx
